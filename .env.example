# =============================================================================
# AuraNER / NER-RouteAI — environment template
# =============================================================================
# Copy this file to `.env.local` for local development.
# Never commit `.env`, `.env.local`, or real secrets.
#
# NEXT_PUBLIC_* values are exposed to the browser. Put only publishable keys there.
# Service-role keys, provider secrets, and database URLs stay server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# development | staging | production
APP_ENV=development
NEXT_PUBLIC_APP_NAME=AuraNER
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (PostgreSQL + PostGIS + Auth + Realtime)
# Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server only. Never prefix with NEXT_PUBLIC_. Never import in Client Components.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: direct Postgres URL for migrations / scripts (server only)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Firebase Authentication & FCM (Production Required)
# Firebase Console → Project Settings
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# -----------------------------------------------------------------------------
# Authentication & Session Security
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_SECRET_AT_LEAST_32_CHARS
AUTH_OTP_CHANNELS=email,phone
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_ATTEMPT_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# AI & Multi-Agent Model Providers
# Options for AI_PROVIDER: openai | anthropic | gemini | azure | deepseek | openrouter | none
# -----------------------------------------------------------------------------
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Maps
# NEXT_PUBLIC_MAP_PROVIDER selects the client renderer.
# Tile URLs must not embed private tokens when possible (use a proxy for secret styles).
# -----------------------------------------------------------------------------
# maplibre | mapbox | google | leaflet
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# -----------------------------------------------------------------------------
# Enterprise API Keys (server-only — NEVER prefix with NEXT_PUBLIC_)
# These keys enable Tier-1 enterprise routing, geocoding, weather, and map matching.
# When unconfigured, the platform auto-falls-back to open engines (OSRM, Nominatim,
# Open-Meteo) via Circuit Breaker. All keys are optional for local development.
# -----------------------------------------------------------------------------
# NextBillion.ai Route Optimization, Matrix, & Commercial Truck Routing
# NEXTBILLION_API_KEY=

# Google Maps Platform: Routes API (Advanced), Address Validation, Geocoding
# GOOGLE_MAPS_API_KEY=

# Mapbox: Map Matching API, Geocoding v6, Navigation, Vector Tiles
# MAPBOX_ACCESS_TOKEN=

# Tomorrow.io: Weather on Routes API (hyperlocal minute-by-minute)
# TOMORROW_IO_API_KEY=

# OpenWeatherMap: One Call API 3.0
# OPENWEATHERMAP_API_KEY=

# -----------------------------------------------------------------------------
# Routing
# Circuit breaker auto-failover: enterprise (nextbillion/google/mapbox) → OSRM fallback
# nextbillion | google | mapbox | osrm | graphhopper | openrouteservice | mock
# -----------------------------------------------------------------------------
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org

# -----------------------------------------------------------------------------
# Geocoding / destination search
# Circuit breaker auto-failover: enterprise (mapbox/google) → Nominatim + NER Index
# mapbox | google | nominatim | mock
# Nominatim: respect usage policy; set a real contact URL in production.
# -----------------------------------------------------------------------------
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=AuraNER/1.0 (https://YOUR_PRODUCTION_DOMAIN)

# -----------------------------------------------------------------------------
# Weather
# Circuit breaker auto-failover: enterprise (tomorrow/openweathermap) → NWP models
# tomorrow | openweathermap | open-meteo | mock
# -----------------------------------------------------------------------------
WEATHER_PROVIDER=open-meteo

# Treat observations older than this as stale (UNVERIFIED_STALE flag)
WEATHER_STALE_AFTER_SECONDS=1800

# -----------------------------------------------------------------------------
# Telemetry
# EKF (Extended Kalman Filter) coordinate smoothing runs for all providers.
# mock = simulated fleet positions for development only.
# Production: rest | supabase_realtime | mqtt
# -----------------------------------------------------------------------------
TELEMETRY_PROVIDER=mock
TELEMETRY_STALE_AFTER_SECONDS=60

# MQTT Enterprise Broker (HiveMQ / EMQX)
# MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_PREFIX=auraner/telemetry

# -----------------------------------------------------------------------------
# Notifications (server)
# -----------------------------------------------------------------------------
NOTIFICATION_PROVIDER=log
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Feature flags (strings: true | false)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_VOICE_GUIDANCE=true
NEXT_PUBLIC_ENABLE_PWA=false
ALLOW_MOCK_PROVIDERS=true
