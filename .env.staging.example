# =============================================================================
# AuraNER / NER-Route AI — Staging Environment Template (.env.staging.example)
# =============================================================================
# Copy to `.env.staging` in CI/CD secrets vault. NEVER commit real credentials.
# =============================================================================

APP_ENV=staging
LOG_LEVEL=info
NEXT_PUBLIC_APP_NAME=AuraNER (Staging)
NEXT_PUBLIC_APP_URL=https://staging.ne-routeai.in

# Backend & Data Layer (Managed Azure / AWS staging instances)
FASTAPI_BACKEND_URL=https://api-staging.ne-routeai.in
DATABASE_URL=postgresql://staging_user:STAGING_PASSWORD@staging-db.postgres.database.azure.com:5432/ner_routeai_staging?sslmode=require
REDIS_URL=rediss://:STAGING_REDIS_AUTH@staging-redis.redis.cache.windows.net:6380/0

# Supabase Staging Project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Firebase Authentication (Staging Project)
FIREBASE_PROJECT_ID=auraner-staging
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@auraner-staging.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY is injected via Azure Key Vault
NEXT_PUBLIC_FIREBASE_PROJECT_ID=auraner-staging
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=auraner-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_STAGING_FIREBASE_WEB_API_KEY

# Authentication & Session Security (Min 32 characters in staging/production)
JWT_SECRET=STAGING_RANDOM_CRYPTOGRAPHIC_SECRET_KEY_MIN_32_CHARS

# Maps & Vector Tiles
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Routing Provider (Staging cluster or Tier-1 test keys)
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://osrm-staging.ne-routeai.in
# NEXTBILLION_API_KEY=

# Geocoding Provider
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=AuraNER-Staging/1.0 (https://staging.ne-routeai.in)

# Weather Provider
WEATHER_PROVIDER=open-meteo
WEATHER_STALE_AFTER_SECONDS=1800
# TOMORROW_IO_API_KEY=

# Telemetry
TELEMETRY_PROVIDER=rest
TELEMETRY_STALE_AFTER_SECONDS=60
MQTT_TOPIC_PREFIX=auraner/telemetry/staging

# Notifications
NOTIFICATION_PROVIDER=in_app

# Storage (Azure Blob Staging)
STORAGE_PROVIDER=azure_blob
STORAGE_BUCKET_NAME=auraner-staging-storage

# Observability
OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=https://staging-collector.ne-routeai.in:4318

# Feature Flags
ALLOW_MOCK_PROVIDERS=false
NEXT_PUBLIC_ENABLE_VOICE_GUIDANCE=true
NEXT_PUBLIC_ENABLE_PWA=true
