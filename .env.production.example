# =============================================================================
# AuraNER / NER-Route AI — Production Environment Template (.env.production.example)
# =============================================================================
# Injected strictly via Azure Key Vault / AWS Secrets Manager at container runtime.
# NEVER commit real credentials to git.
# =============================================================================

APP_ENV=production
LOG_LEVEL=warn
NEXT_PUBLIC_APP_NAME=AuraNER
NEXT_PUBLIC_APP_URL=https://ne-routeai.in

# Backend & Data Layer (Azure Central India High-Availability Cluster)
FASTAPI_BACKEND_URL=https://api.ne-routeai.in
DATABASE_URL=postgresql://prod_app_user:PROD_PASSWORD@prod-db.postgres.database.azure.com:5432/ner_routeai_prod?sslmode=require
REDIS_URL=rediss://:PROD_REDIS_AUTH@prod-redis.redis.cache.windows.net:6380/0

# Supabase Production Project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROD_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PROD_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_KEY

# Firebase Authentication (Production Project)
FIREBASE_PROJECT_ID=auraner-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@auraner-production.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY injected via Azure Key Vault
NEXT_PUBLIC_FIREBASE_PROJECT_ID=auraner-production
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=auraner-production.firebaseapp.com
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_PRODUCTION_FIREBASE_WEB_API_KEY

# Authentication & Session Security (Strictly injected via Azure Key Vault in production)
JWT_SECRET=PRODUCTION_RANDOM_CRYPTOGRAPHIC_SECRET_KEY_MIN_32_CHARS

# Maps & Vector Tiles
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Enterprise Routing Providers
ROUTING_PROVIDER=nextbillion
ROUTING_BASE_URL=https://api.nextbillion.io
NEXTBILLION_API_KEY=YOUR_NEXTBILLION_ENTERPRISE_KEY
# GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# Enterprise Geocoding
GEOCODING_PROVIDER=mapbox
GEOCODING_USER_AGENT=AuraNER-Prod/1.0 (https://ne-routeai.in)
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_PRODUCTION_TOKEN

# Enterprise Weather
WEATHER_PROVIDER=tomorrow
WEATHER_STALE_AFTER_SECONDS=1800
TOMORROW_IO_API_KEY=YOUR_TOMORROW_IO_KEY

# High-Throughput Telemetry
TELEMETRY_PROVIDER=mqtt
TELEMETRY_STALE_AFTER_SECONDS=60
MQTT_BROKER_URL=tls://broker.ne-routeai.in:8883
MQTT_TOPIC_PREFIX=auraner/telemetry/prod

# Notifications
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=YOUR_RESEND_API_KEY

# Object Storage (Azure Blob ZRS in Pune Data Center)
STORAGE_PROVIDER=azure_blob
STORAGE_BUCKET_NAME=auraner-production-storage

# Observability (Azure Monitor / Application Insights)
OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=https://prod-collector.ne-routeai.in:4318
AZURE_APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=https://centralindia-0.in.applicationinsights.azure.com/

# Feature Flags (MOCK PROVIDERS STRICTLY FORBIDDEN IN PRODUCTION)
ALLOW_MOCK_PROVIDERS=false
NEXT_PUBLIC_ENABLE_VOICE_GUIDANCE=true
NEXT_PUBLIC_ENABLE_PWA=true
